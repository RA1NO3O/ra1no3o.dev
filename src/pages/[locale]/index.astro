---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import IconLink from "../../components/IconLink.astro";
import { profiles, site } from "../../data/site";
import { copy } from "../../i18n/copy";
import { htmlLang, isLocale, localePaths } from "../../i18n/locale";
import recentPhoto from "../../assets/photos/IMG_1044.jpeg";

export function getStaticPaths() {
	return localePaths();
}

const locale = Astro.params.locale;
if (!isLocale(locale)) throw new Error(`Unexpected locale: ${String(locale)}`);
const text = copy[locale];
const taken = "2024-04-28";
const takenLabel = new Intl.DateTimeFormat(htmlLang[locale], {
	year: "numeric",
	month: "long",
	day: "numeric",
	timeZone: "UTC",
}).format(new Date(`${taken}T00:00:00Z`));
---

<Base
	locale={locale}
	path=""
	title={`${site.name} · ${site.handle}`}
	description={text.homeDescription}
>
	<p class="sentence">{text.sentence}</p>
	<p class="summary">{text.summary}</p>
	<section class="group">
		<h2>{text.photos}</h2>
		<figure class="photo">
			<Image
				src={recentPhoto}
				alt={text.photoAlt}
				widths={[640, 960, 1280, 1920]}
				sizes="(min-width: 44rem) 34rem, calc(100vw - 2.5rem)"
				loading="eager"
				fetchpriority="high"
			/>
			<figcaption>
				<time datetime={taken}>{takenLabel}</time>
			</figcaption>
		</figure>
	</section>
	<ul class="profiles">
		{
			profiles.map((profile) => (
				<li>
					<IconLink href={profile.href} rel={"rel" in profile ? profile.rel : undefined}>
						{profile.label}
					</IconLink>
				</li>
			))
		}
	</ul>
</Base>
